# Existing provider credentials (Instagram Login credentials, not Facebook Login).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Not required for authenticated uploads.
YOUTUBE_API_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Run: python scripts/setup_local.py (generates missing secrets in .env).
SERVICE_API_KEY=
TOKEN_ENCRYPTION_KEY=
BASE_URL=http://localhost:8000
DATABASE_PATH=data/relay.sqlite3
INSTAGRAM_API_VERSION=v25.0
MAX_UPLOAD_BYTES=2147483648
# Public-read bucket used by the Instagram frontend publisher (JPEG and MP4 uploads).
INSTAGRAM_MEDIA_BUCKET=
# Optional local-only media folder. On localhost with no bucket, Relay defaults to
# data/local-media and disables provider publishing; this overrides that folder.
# LOCAL_MEDIA_DIR=data/local-media
# Optional exact overrides; defaults are BASE_URL + /oauth/{provider}/callback.
# YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/youtube/callback
# INSTAGRAM_REDIRECT_URI=https://your-public-host/oauth/instagram/callback

# Cloud database (optional). DATABASE_BUCKET enables snapshot storage; the service
# fails closed when that snapshot is missing rather than creating an empty database.
# For a new deployment, create the first snapshot once with scripts/init_cloud_database.py.
# DATABASE_BUCKET=
