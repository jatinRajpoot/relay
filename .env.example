# Existing provider credentials (Instagram Login credentials, not Facebook Login).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Not required for authenticated uploads.
YOUTUBE_API_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Run: python scripts/setup_local.py (generates missing secrets in .env).
SERVICE_API_KEY=
TOKEN_ENCRYPTION_KEY=
BASE_URL=http://localhost:8000
DATABASE_PATH=data/relay.sqlite3
INSTAGRAM_API_VERSION=v25.0
MAX_UPLOAD_BYTES=2147483648
# Optional exact overrides; defaults are BASE_URL + /oauth/{provider}/callback.
# YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/youtube/callback
# INSTAGRAM_REDIRECT_URI=https://your-public-host/oauth/instagram/callback
